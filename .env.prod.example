# V0.72.0 P3-b · 生产环境 .env.prod 模板
# ============================================
# 1. 复制本文件为 .env.prod：  cp .env.prod.example .env.prod
# 2. 填写真实值（ADMIN_TOKEN / SMTP / SERVERCHAN_SENDKEY / DOMAIN 等）
# 3. 部署时用 env_file 挂载： docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️ .env.prod 已加入 .gitignore，绝不可提交到 git

# ===== 应用环境 =====
APP_ENV=prod
DEBUG=false
LOG_LEVEL=INFO

# ===== CORS（公网域名） =====
# 多个域名用逗号分隔，**不要用 *** （CSRF 风险）
CORS_ORIGINS=https://gold.example.com

# ===== 安全：写端点 admin 守卫 =====
# 必须设置 ≥32 字符随机串；写端点（positions/accounts/settings/backtest/news）需
# 客户端带 X-Admin-Token 头。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=__FILL_ME_WITH_SECRETS_TOKEN_URLSAFE_32__


# ===== 安全：限速 =====
# 60s 滑动窗口 / per-IP。0 = 禁用。生产 120 起步，异常峰值 240。
RATE_LIMIT_PER_MIN=120

# ===== V0.75.0 安全：多用户登录 =====
# 公网部署**强烈建议开启**（否则任何人拿到地址即可读写你的持仓与账本）。
# 开启后：/docs、/redoc、/openapi.json 在 APP_ENV=prod 下自动关闭（不暴露接口清单）。
AUTH_ENABLED=true

# 私有部署建议 false（只由管理员建号）；家庭 / 合伙场景设 true。
# 无论取值，库中无用户时首个注册者必成为 owner（初始化管理员）。
ALLOW_REGISTRATION=false

# 14 天绝对过期；不随活跃度顺延。
SESSION_TTL_HOURS=336

# ⚠ 生产必须 true（本示例已预置）。站点未走 HTTPS 时会「登录成功却立刻要求再登录」，
# 因为浏览器不会回传 Secure cookie。
SESSION_COOKIE_NAME=pm_session
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_NAME=pm_csrf

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
SESSION_TOUCH_SECONDS=300

# nginx 前置（见 nginx/conf.d/gold.conf）→ 取 X-Forwarded-For 首跳做审计 IP。
TRUST_PROXY_HEADERS=true

# ===== 行情源 =====
# 生产用稳定的 provider；如需企业内网代理，改 URL。
MARKET_PROVIDER=akshare
XAU_FALLBACK_CHAIN=goldapi,sina,etf_history
QUOTE_CACHE_TTL=300
NETWORK_ENABLED=true

# ===== 行情缓存 =====
SERVED_CACHE_TTL_SECONDS=600
INTRADAY_REFRESH_ENABLED=true
INTRADAY_REFRESH_HOURS=9:30,11:30,14:00,15:30

# ===== 告警推送 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
NOTIFY_FROM=

SERVERCHAN_SENDKEY=

# 静默时段（BJT；跨夜有效）
ALERT_QUIET_HOURS=22:00-07:00
ALERT_VOLATILITY_PCT=3.0

# ===== 数据库（默认 SQLite + named volume） =====
# 如换 PostgreSQL，改 URL 并加 alembic 迁移适配。
DATABASE_URL=sqlite+aiosqlite:////app/data/gold_etf.db
