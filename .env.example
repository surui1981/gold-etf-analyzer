# ===== 应用基础 =====
APP_NAME=gold-etf-analyzer
APP_ENV=dev
DEBUG=true

# ===== 服务端口（用户偏好本地 127.0.0.1:8888）=====
# uvicorn 启动时通过 --host/--port 指定，此处仅作提示
HOST=127.0.0.1
PORT=8888

# ===== 数据库 =====
# SQLite 文件路径（相对项目根目录）
DATABASE_URL=sqlite+aiosqlite:///./data/gold_etf.db

# ===== CORS =====
# 逗号分隔的前端来源，* 表示全部放行（仅本地开发）
CORS_ORIGINS=*

# ===== 行情源 provider（V0.59.0 新增，P1 #5 行情源配置化）=====
# 可选: akshare | mock | eastmoney_only | sina_only
#  - akshare:        默认。主源东财 + 备源新浪，外盘英为财情（推荐）
#  - mock:           离线演示 / 测试专用。返回确定性序列，不触网
#  - eastmoney_only: 只走东方财富。剔除新浪子进程开销，但东财不可达时立即失败
#  - sina_only:      只走新浪。适用于东财 403 但 sina 可用的场景
MARKET_PROVIDER=akshare

# 行情缓存 TTL（秒）；测试场景可设 0 禁用
QUOTE_CACHE_TTL=300

# 是否允许行情网络请求（false 时强制走 Mock，避免测试环境触网）
NETWORK_ENABLED=true
