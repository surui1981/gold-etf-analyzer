# ===== 应用基础 =====
APP_NAME=gold-etf-analyzer
APP_ENV=dev
DEBUG=true

# ===== 服务端口（用户偏好本地 127.0.0.1:8888）=====
# uvicorn 启动时通过 --host/--port 指定，此处仅作提示
HOST=127.0.0.1
PORT=8888

# ===== 数据库 =====
# SQLite 文件路径（相对项目根目录）
DATABASE_URL=sqlite+aiosqlite:///./data/gold_etf.db

# ===== CORS =====
# 逗号分隔的前端来源，* 表示全部放行（仅本地开发）
CORS_ORIGINS=*

# ===== 行情源 provider（V0.59.0 新增，P1 #5 行情源配置化）=====
# 可选: akshare | mock | eastmoney_only | sina_only
#  - akshare:        默认。主源东财 + 备源新浪，外盘英为财情（推荐）
#  - mock:           离线演示 / 测试专用。返回确定性序列，不触网
#  - eastmoney_only: 只走东方财富。剔除新浪子进程开销，但东财不可达时立即失败
#  - sina_only:      只走新浪。适用于东财 403 但 sina 可用的场景
MARKET_PROVIDER=akshare

# 行情缓存 TTL（秒）；测试场景可设 0 禁用
QUOTE_CACHE_TTL=300

# 是否允许行情网络请求（false 时强制走 Mock，避免测试环境触网）
NETWORK_ENABLED=true

# ===== 行情实时性（V0.60.0 新增）=====
# Served cache 日内 TTL（秒）；超过此时间后下次请求会全量重算。
# 默认 600（10 分钟），按"半日 A 股"量级；设置 0 表示仅依赖跨日 + invalidate_for_news 失效。
SERVED_CACHE_TTL_SECONDS=600

# 是否启用日内多次预热（默认启用）。设为 false 回退到仅每日 07:00 BJT 一次的旧行为。
INTRADAY_REFRESH_ENABLED=true

# 日内预热触发时刻（北京时分，逗号分隔）。覆盖 A 股 + SGE 关键时点。
# 默认：09:30 开盘前 / 11:30 上午收盘前 / 14:00 下午开盘前 / 15:30 SGE 收盘前。
INTRADAY_REFRESH_HOURS=9:30,11:30,14:00,15:30

# ===== 告警推送（V0.72.0 P3-b 新增）=====
# 邮件 SMTP 配置（QQ 邮箱 / Gmail / 163 邮箱均可；端口 465 SSL；用「授权码」不是登录密码）
# 留空 SMTP_HOST 即禁用邮件渠道（仅微信 + 浏览器通知）。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
NOTIFY_FROM=

# Server 酱微信 SendKey（https://sct.ftqq.com/ 申请）
# 留空即禁用微信渠道。
SERVERCHAN_SENDKEY=

# 告警规则（用户可在 /static/settings.html 页面修改；这里是启动默认值）
# 静默时段（BJT HH:MM-HH:MM，跨夜有效；默认 22:00-07:00）
ALERT_QUIET_HOURS=22:00-07:00
# 单日波动告警阈值（百分比；绝对值 ≥ 此值触发）
ALERT_VOLATILITY_PCT=3.0

# ===== V0.72.0 P3-b · 安全前置 =====
# 写端点 admin 守卫 token（X-Admin-Token 头）。留空 = dev 模式跳过校验。
# 生产部署必须设置：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 例：ADMIN_TOKEN=AbCdEf123...32+ chars
ADMIN_TOKEN=

# per-IP 限速（60s 滑动窗口）。0 = 禁用。默认 120 req/min 足够 9 页 SPA + 60s 轮询。
# 生产异常峰值可调 240。监控到 429 持续出现时再调高。
RATE_LIMIT_PER_MIN=120

# ===== V0.75.0 · 认证骨架（多用户登录）=====
# 总开关。**默认 false = 单用户模式**：不解析会话、不校验 CSRF、不做门禁，
# 所有请求以 user_id=1 运行，行为与 V0.74.3 完全一致。
# 设为 true 后：除 /api/v1/health 与 /api/v1/auth/{status,login,register,logout}、
# /api/v1/telemetry/ingest 外，全部 API 都要求先登录。
AUTH_ENABLED=false

# 是否允许自助注册。false 时只有已存在的用户可以登录；
# 注意：库中还没有任何用户时，首个注册者**始终**可以建号（否则无人能初始化）。
ALLOW_REGISTRATION=true

# 会话有效期（小时）。默认 336 = 14 天。绝对过期，不随活跃度顺延。
SESSION_TTL_HOURS=336

# 会话 / CSRF cookie 名与 Secure 属性。
# ⚠ SESSION_COOKIE_SECURE=true 必须搭配 HTTPS；本地 http://127.0.0.1 下
# 浏览器不会回传 Secure cookie（表现为「登录成功但立刻又要求登录」）。
SESSION_COOKIE_NAME=pm_session
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=pm_csrf

# bcrypt 代价因子（cost）。12 ≈ 每次校验 250ms，是抗离线爆破与登录体感的平衡点。
# 调高会线性增加登录延迟；改动后**既有密码哈希仍然有效**（cost 写在哈希串里）。
BCRYPT_COST=12

# 登录失败锁定：window 内失败达 max 次即锁定 lockout 分钟（账号与 IP 双维度）。
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# 会话 last_seen_at 落库节流（秒），避免每个 API 请求都写一次 UPDATE。0 = 每次都写。
SESSION_TOUCH_SECONDS=300

# 信任反向代理的 X-Forwarded-For 首跳作为客户端 IP（nginx / CDN 前置时为 true）。
# ⚠ XFF 可伪造，仅用于审计展示与登录节流，不用于安全判定。直连部署保持 false。
TRUST_PROXY_HEADERS=false
